<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <!-- Titre de l'application -->
    <TextView
        android:id="@+id/textViewTitre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titre"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <!-- Valeur courante du compteur, affichée en grand -->
    <TextView
        android:id="@+id/textViewCompteur"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/valeur_initiale"
        android:textSize="72sp"
        android:textStyle="bold"
        android:layout_marginBottom="40dp" />

    <!-- Ligne des boutons - / + -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/buttonDecrementer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/moins"
            android:textSize="24sp"
            android:layout_marginEnd="16dp"
            android:minWidth="96dp" />

        <Button
            android:id="@+id/buttonIncrementer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/plus"
            android:textSize="24sp"
            android:minWidth="96dp" />
    </LinearLayout>

    <!-- Ligne des boutons -5 / +5 (amélioration) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/buttonDecrementer5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/moins_cinq"
            android:textSize="20sp"
            android:layout_marginEnd="16dp"
            android:minWidth="96dp" />

        <Button
            android:id="@+id/buttonIncrementer5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/plus_cinq"
            android:textSize="20sp"
            android:minWidth="96dp" />
    </LinearLayout>

    <!-- Bouton Réinitialiser -->
    <Button
        android:id="@+id/buttonReinitialiser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/reinitialiser"
        android:textSize="18sp"
        android:layout_marginTop="8dp" />

</LinearLayout>
